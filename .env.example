PORT=3000
MONGODB_URI=mongodb://localhost:27017/flowhub
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3001
# Public URL of the web app (flowhub.com); used in email links and Stripe redirects
APP_URL=http://localhost:3001

# Email via AWS SES. Leave MAIL_FROM empty to log emails to the console instead.
MAIL_FROM=
AWS_REGION=ap-south-1

# Stripe. Leave empty to disable paid plans (billing endpoints return 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Observe telemetry (optional). Disabled when OBSERVE_APP_KEY is empty.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Platform owners who can open /app/admin (comma-separated emails)
SUPER_ADMIN_EMAILS=
